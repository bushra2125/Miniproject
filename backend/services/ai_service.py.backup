_model = None
_model_loaded: bool = False


def load_model() -> bool:
    """
    Attempt to load the trained model from the path specified in .env.

    Returns:
        True if the model loaded successfully, False otherwise.

    TODO: Implement this function when your model is ready.
    """
    global _model, _model_loaded

    model_path = settings.model_path

    if not os.path.exists(model_path):
        print(
            f"[AI Service] Model file not found at '{model_path}'. "
            "AI predictions will not be available. "
            "See README.md → Step 5 to add your model."
        )
        _model_loaded = False
        return False

