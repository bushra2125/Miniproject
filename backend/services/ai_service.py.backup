    # interpreter.allocate_tensors()
    # _model = interpreter
    # -----------------------------------------------------------------

    print(f"[AI Service] Model loaded from '{model_path}'.")
    _model_loaded = True
    return True


def is_model_loaded() -> bool:
    """Returns True if the model has been loaded and is ready for inference."""
    return _model_loaded


