# =============================================================================
# FruitQualityAI — Backend Environment Variables Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in your actual values in the new ".env" file
#   3. NEVER commit the ".env" file to Git — it is already in .gitignore
# =============================================================================

# ---- Firebase Configuration ----
# Path to your Firebase service account JSON key file (relative to backend/)
FIREBASE_SERVICE_ACCOUNT_PATH=core/firebase-service-account.json

# Your Firebase project ID (found in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- FastAPI Application Settings ----
# Environment: "development" or "production"
APP_ENV=development

# Port the backend server will run on
APP_PORT=8000

# Allowed origins for CORS (comma-separated, e.g. http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# ---- AI Model Settings (fill in when your model is ready) ----
# Path to your trained model file inside ml_models/
MODEL_PATH=ml_models/your_model_file.h5
